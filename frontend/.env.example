# Enquiry API is hosted in Supabase Edge Functions; no Express server is required.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Server-only admin settings. Never prefix these with NEXT_PUBLIC_.
ADMIN_EMAIL=
# Password hash format: salt:hex-scrypt-hash (64 bytes).
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_API_SECRET=
# Preferred public website origin; defaults to the owner-confirmed domain.
SITE_URL=https://internfy.in
